# Runtime
NODE_ENV=production
PORT=3000

# App / Branding
APP_NAME=SigFlow
APP_BASE_URL=https://sigflow.example.com
BRAND_NAME=Example Company
BRAND_WEBSITE_URL=https://www.example.com
LEGAL_PRIVACY_URL=https://www.example.com/privacy
LEGAL_IMPRINT_URL=https://www.example.com/imprint

# Public UI links
NEXT_PUBLIC_BRAND_NAME=Example Company
NEXT_PUBLIC_BRAND_WEBSITE_URL=https://www.example.com
NEXT_PUBLIC_LEGAL_PRIVACY_URL=https://www.example.com/privacy
NEXT_PUBLIC_LEGAL_IMPRINT_URL=https://www.example.com/imprint

# OTP / Session
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_RATE_LIMIT_WINDOW_SECONDS=300
OTP_REQUEST_RATE_LIMIT_COUNT=5
OTP_VERIFY_RATE_LIMIT_COUNT=20
SESSION_TTL_SECONDS=7200

# Redis (required unless ALLOW_INMEMORY_FALLBACK=true)
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=sigflow
ALLOW_INMEMORY_FALLBACK=false

# SMTP (required)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=change_me
SMTP_FROM=SigFlow <no-reply@example.com>
SMTP_REPLY_TO=support@example.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
